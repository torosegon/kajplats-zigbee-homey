          "hint": {
            "en": "Which ZCL ColorControl command sets the colour. 'Automatic' uses hue/saturation if the bulb reports support for it, otherwise CIE xy. Change it if colours are wrong.",
            "hu": "Melyik ZCL ColorControl paranccsal állítja be a színt. Az 'Automatikus' a hue/saturation parancsot használja, ha az izzó jelzi, hogy támogatja, egyébként CIE xy-t. Akkor módosítsd, ha a színek hibásak."
          },
          "values": [
            {
              "id": "auto",
              "label": {
                "en": "Automatic",
                "hu": "Automatikus"
              }
            },
            {
